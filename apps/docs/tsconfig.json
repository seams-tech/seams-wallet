{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "react", "react-dom"],
    "paths": {
      "@seams/mpc-wallet/*": ["../../packages/mpc-wallet/dist/types/mpc-wallet/src/*"],
      "@seams/wallet-connect/*": ["../../packages/wallet-connect/dist/types/wallet-connect/src/*"]
    }
  },
  "include": [
    "src/.vitepress/**/*.ts",
    "src/examples/**/*.ts",
    "src/examples/**/*.tsx",
    "vite-env.d.ts"
  ]
}
