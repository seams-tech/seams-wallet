{
  "extends": "../packages/auth/tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "allowJs": true,
    "checkJs": false,
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "../node_modules/@types"
    ],
    "paths": {
      "@shared/*": [
        "../packages/shared-ts/src/*"
      ]
    }
  },
  "include": [
    "auth/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
