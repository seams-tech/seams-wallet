{
  "extends": "../packages/mpc-wallet/tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "types": ["@playwright/test", "node", "react", "react-dom", "vite/client"],
    "typeRoots": [
      "./node_modules/@types",
      "../packages/mpc-wallet/node_modules/@types",
      "../packages/node_modules/@types",
      "../node_modules/@types",
      "./node_modules",
      "../packages/mpc-wallet/node_modules",
      "../packages/node_modules",
      "../node_modules"
    ],
    "paths": {
      "@voiceid/*": ["../packages/voiceid/src/*"],
      "@wallet-connect/*": ["../packages/wallet-connect/src/*"],
      "@seams/mpc-wallet/voiceid": ["../packages/mpc-wallet/src/voiceid.ts"],
      "@seams/mpc-wallet/react": ["../packages/mpc-wallet/src/react/index.ts"],
      "@seams/mpc-wallet/client": ["../packages/mpc-wallet/src/client.ts"],
      "@seams/wallet-connect/client": ["../packages/wallet-connect/src/client.ts"],
      "@seams/wallet-connect/react": ["../packages/wallet-connect/src/react/index.ts"],
      "@/core/runtime": ["../packages/mpc-wallet/src/core/runtime/index.ts"],
      "@/core/runtime/*": ["../packages/mpc-wallet/src/core/runtime/*"],
      "@/*": ["../packages/mpc-wallet/src/*"],
      "@/plugins/*": ["../packages/mpc-wallet/src/plugins/*"],
      "@shared/utils": ["../packages/shared-ts/src/utils/index.ts"],
      "@shared/*": ["../packages/shared-ts/src/*"],
      "@shared/threshold": ["../packages/shared-ts/src/threshold/index.ts"],
      "@seams-internal/shared-ts/*": ["../packages/shared-ts/src/*"],
      "@server": ["../packages/mpc-wallet-server/src/index.ts"],
      "@server/*": ["../packages/mpc-wallet-server/src/*"],
      "@build-paths": ["../packages/mpc-wallet/build-paths.ts"],
      "@seams/host/server-types": ["../packages/mpc-wallet-server/src/index.ts"],
      "@seams/host/cloud-host": ["../packages/mpc-wallet-server/src/cloud-host.ts"],
      "@seams/host/hosted-wallet-gateway": [
        "../packages/mpc-wallet-server/src/hosted-wallet-gateway.ts"
      ],
      "@seams/host/router/cloudflare": [
        "../packages/mpc-wallet-server/src/router/cloudflare-adaptor.ts"
      ],
      "@seams/host/router/ror": ["../packages/mpc-wallet-server/src/router/ror-adaptor.ts"],
      "@seams/host/wasm/signer": ["../packages/mpc-wallet-server/src/wasm/signer.ts"]
    }
  },
  "include": [
    "e2e/intended-behaviours/**/*.ts",
    "conformance/**/*.ts",
    "types/sdk-paths.d.ts",
    "r150-hosted/gateway/**/*.ts",
    "intended-app/src/**/*.ts",
    "intended-app/src/**/*.tsx"
  ],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
