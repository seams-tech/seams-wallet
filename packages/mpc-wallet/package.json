{
  "name": "@seams/mpc-wallet",
  "version": "0.76.0",
  "type": "module",
  "description": "Seams MPC wallet: embedded NEAR and EVM-family wallets with threshold signing, React components and the VoiceID page code",
  "exports": {
    "./package.json": "./package.json",
    "./client": {
      "types": "./dist/types/mpc-wallet/src/client.d.ts",
      "import": "./dist/esm/client.js",
      "default": "./dist/esm/client.js"
    },
    "./react": {
      "types": "./dist/types/mpc-wallet/src/react/index.d.ts",
      "import": "./dist/esm/react/index.js",
      "default": "./dist/esm/react/index.js"
    },
    "./server": {
      "types": "./dist/types/mpc-wallet/src/server.d.ts",
      "import": "./dist/esm/server.js",
      "default": "./dist/esm/server.js"
    },
    "./voiceid": {
      "types": "./dist/types/mpc-wallet/src/voiceid.d.ts",
      "import": "./dist/esm/voiceid.js",
      "default": "./dist/esm/voiceid.js"
    },
    "./styles.css": {
      "types": "./dist/types/mpc-wallet/src/react/styles.d.ts",
      "default": "./dist/esm/react/styles/styles.css"
    }
  },
  "files": [
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "dist/",
    "!dist/**/*.map",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "client": [
        "dist/types/mpc-wallet/src/client.d.ts"
      ],
      "react": [
        "dist/types/mpc-wallet/src/react/index.d.ts"
      ],
      "server": [
        "dist/types/mpc-wallet/src/server.d.ts"
      ],
      "voiceid": [
        "dist/types/mpc-wallet/src/voiceid.d.ts"
      ]
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prepack": "node ../../scripts/package-license.mjs stage",
    "postpack": "node ../../scripts/package-license.mjs clean",
    "build:sdk": "./scripts/build/build-sdk.sh",
    "build:types": "pnpm -C ../wallet-connect build:types && tsrs -p tsconfig.build.json && node ./scripts/build/rewrite-declaration-aliases.mjs",
    "build:wasm": "./scripts/build/build-wasm.sh",
    "build:sdk-full": "./scripts/build/build-full.sh",
    "build:prod": "./scripts/build/build-prod.sh",
    "build:static-wallet-assets": "node ./scripts/build/emit-static-wallet-assets.mjs",
    "build:rolldown": "rolldown -c rolldown.config.ts",
    "dev": "rolldown -c rolldown.config.ts -w",
    "smoke:evm-crypto:node-runtime": "node ./scripts/smoke/smoke-evm-crypto-node-runtime.mjs",
    "smoke:evm-crypto:workers-runtime": "node ./scripts/smoke/smoke-evm-crypto-workers-runtime.mjs",
    "smoke:evm-crypto:runtimes": "pnpm smoke:evm-crypto:node-runtime && pnpm smoke:evm-crypto:workers-runtime",
    "build:check:fresh": "./scripts/build/check-build-freshness.sh",
    "check:bundle-size": "node ./scripts/checks/report-wallet-iframe-bundle-size.mjs",
    "check:runtime-entry-bundles": "node ./scripts/checks/assert-runtime-entry-bundles.mjs",
    "check:static-wallet-assets": "node ./scripts/checks/assert-static-wallet-assets.mjs",
    "check:hosted-wallet-docs": "node ./scripts/checks/assert-hosted-wallet-docs.mjs",
    "smoke:static-wallet-origin": "node ./scripts/checks/smoke-static-wallet-origin.mjs",
    "check:wasm-exports": "node ./scripts/checks/report-wasm-export-surface.mjs",
    "check:wasm-import-drift": "node ./scripts/checks/report-wasm-export-surface.mjs --assert",
    "size:lite": "node ./scripts/reports/report-lite-bundle-sizes.mjs",
    "size:lite:check": "node ./scripts/reports/report-lite-bundle-sizes.mjs --check",
    "evidence:yaos-ab:local-artifacts": "node ./scripts/reports/report-yaos-ab-local-artifacts.mjs ../../docs/evidence/yaos-ab-phase14b-local-artifacts-v1.json",
    "type-check": "pnpm -C ../wallet-connect build:types && tsrs --noEmit",
    "check:declarations-external": "node ./scripts/checks/check-declarations-resolve-externally.mjs"
  },
  "keywords": [
    "seams",
    "wallet",
    "signing-runtime",
    "browser",
    "NEAR",
    "EVM",
    "blockchain",
    "passkey",
    "react",
    "typescript",
    "sdk"
  ],
  "author": "web3authn.org",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seams-tech/seams-wallet.git"
  },
  "bugs": {
    "url": "https://github.com/seams-tech/seams-wallet/issues"
  },
  "homepage": "https://github.com/seams-tech/seams-wallet#readme",
  "peerDependencies": {
    "@seams/wallet-connect": "0.76.0",
    "jsqr": "1.4.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "jsqr": {
      "optional": true
    }
  },
  "dependencies": {
    "@levischuck/tiny-cbor": "0.2.11",
    "@near-js/types": "2.4.0",
    "@seams/voice-sign": "0.72.0",
    "@seams/voice-verdict": "0.72.0",
    "bs58": "6.0.0",
    "idb": "8.0.3",
    "preact": "10.29.8",
    "qrcode": "1.5.4",
    "voice-glow": "0.2.1"
  },
  "devDependencies": {
    "@seams/wallet-connect": "workspace:*",
    "@simplewebauthn/server": "13.2.2",
    "@types/node": "20.19.13",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "rolldown": "1.0.0-rc.9"
  }
}
