{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "types": ["node", "react", "react-dom", "qrcode", "express"],
    "typeRoots": [
      "./node_modules/@types",
      "../node_modules/@types",
      "../../node_modules/@types",
      "./node_modules",
      "../node_modules",
      "../../node_modules"
    ],
    "useDefineForClassFields": false,
    "paths": {
      "@/core/runtime": ["src/core/runtime/index.ts"],
      "@/core/runtime/*": ["src/core/runtime/*"],
      "@/*": ["src/*"],
      "@shared/*": ["../shared-ts/src/*"],
      "@server": ["../wallet-server/src/index.ts"],
      "@server/*": ["../wallet-server/src/*"],
      "@seams/wallet/advanced": ["src/advanced.ts"],
      "@seams/wallet-server": ["../wallet-server/src/index.ts"],
      "@seams/wallet-server/router/cloudflare": ["../wallet-server/src/router/cloudflare-adaptor.ts"],
      "@seams/wallet-server/router/express": ["../wallet-server/src/router/express-adaptor.ts"],
      "@seams/wallet-server/router/ror": ["../wallet-server/src/router/ror-adaptor.ts"],
      "@seams/wallet-server/wasm/signer": ["../wallet-server/src/wasm/signer.ts"],
      "@build-paths": ["./build-paths.ts"],
      "express": ["./node_modules/@types/express/index.d.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react-dom/client": ["./node_modules/@types/react-dom/client.d.ts"],
      "react-dom/server": ["./node_modules/@types/react-dom/server.d.ts"],
      "qrcode": ["./node_modules/@types/qrcode/index.d.ts"],
      "*": ["./node_modules/*", "../node_modules/*", "../../node_modules/*"]
    }
  },
  "include": ["src/**/*", "../wallet-server/src/**/*", "../shared-ts/src/**/*"],
  "exclude": ["node_modules", "dist", "../dist", "../../tests/scripts/**/*"]
}
