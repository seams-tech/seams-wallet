{
  "name": "@seams/wallet-server",
  "version": "0.5.32",
  "type": "module",
  "description": "Seams server TypeScript SDK for NEAR and EVM-family wallets",
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/wallet-server/src/index.d.ts",
  "bin": {
    "seams-wallet-server-d1-migrate": "./scripts/d1-local-migrate-signer.mjs",
    "seams-wallet-server-local-init": "./cloudflare-router-ab/scripts/initialize-local-wallet.mjs",
    "seams-wallet-server-local-roles": "./cloudflare-router-ab/scripts/start-local-role-workers.mjs",
    "seams-wallet-server-local": "./cloudflare-router-ab/scripts/start-local-wallet-system.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/wallet-server/src/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./router/express": {
      "types": "./dist/types/wallet-server/src/router/express-adaptor.d.ts",
      "import": "./dist/esm/router/express.js",
      "default": "./dist/esm/router/express.js"
    },
    "./router/cloudflare": {
      "types": "./dist/types/wallet-server/src/router/cloudflare-adaptor.d.ts",
      "import": "./dist/esm/router/cloudflare.js",
      "default": "./dist/esm/router/cloudflare.js"
    },
    "./router/ror": {
      "types": "./dist/types/wallet-server/src/router/ror-adaptor.d.ts",
      "import": "./dist/esm/router/ror.js",
      "default": "./dist/esm/router/ror.js"
    },
    "./storage/tenant-route": {
      "types": "./dist/types/wallet-server/src/storage/tenantRoute.d.ts",
      "import": "./dist/esm/storage/tenantRoute.js",
      "default": "./dist/esm/storage/tenantRoute.js"
    },
    "./wasm/signer": {
      "types": "./dist/types/wallet-server/src/wasm/signer.d.ts",
      "import": "./dist/esm/wasm/signer.js",
      "default": "./dist/esm/wasm/signer.js"
    },
    "./cloud-host": {
      "types": "./dist/types/wallet-server/src/cloud-host.d.ts",
      "import": "./dist/esm/cloud-host.js",
      "default": "./dist/esm/cloud-host.js"
    },
    "./hosted-wallet-gateway": {
      "types": "./dist/types/wallet-server/src/hosted-wallet-gateway.d.ts",
      "import": "./dist/esm/hosted-wallet-gateway.js",
      "default": "./dist/esm/hosted-wallet-gateway.js"
    },
    "./hosted-wallet-gateway-worker": {
      "types": "./dist/types/wallet-server/src/hosted-wallet-gateway-worker.d.ts",
      "import": "./dist/esm/hosted-wallet-gateway-worker.js",
      "default": "./dist/esm/hosted-wallet-gateway-worker.js"
    },
    "./local-hosted-wallet-gateway-worker": {
      "types": "./dist/types/wallet-server/src/local-hosted-wallet-gateway-worker.d.ts",
      "import": "./dist/esm/local-hosted-wallet-gateway-worker.js",
      "default": "./dist/esm/local-hosted-wallet-gateway-worker.js"
    },
    "./artifact-manifest.json": "./artifact-manifest.json",
    "./migrations/d1-signer/*": "./migrations/d1-signer/*",
    "./tenant-root": {
      "types": "./dist/types/wallet-server/src/tenant-root.d.ts",
      "import": "./dist/esm/tenant-root.js",
      "default": "./dist/esm/tenant-root.js"
    },
    "./local-runtime": "./cloudflare-router-ab/scripts/prepare-local-runtime-config.mjs",
    "./local-runtime/*": "./cloudflare-router-ab/scripts/*"
  },
  "files": [
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md",
    "artifact-manifest.json",
    "cloudflare-router-ab/",
    "dist/",
    "!dist/**/*.map",
    "migrations/d1-signer/",
    "scripts/d1-local-migrate-signer.mjs",
    "src/README.md",
    "wrangler.local-hosted-wallet-gateway.toml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ./scripts/rewrite-declaration-imports.mjs && rolldown -c rolldown.config.ts && node ./scripts/copy-wasm-assets.mjs",
    "package:cloudflare-runtime": "node ./scripts/copy-cloudflare-router-runtime.mjs && node ./scripts/write-artifact-manifest.mjs",
    "d1:local:migrate": "node ./scripts/d1-local-migrate-signer.mjs",
    "prepack": "pnpm run package:cloudflare-runtime && node ../../scripts/package-license.mjs stage",
    "postpack": "node ../../scripts/package-license.mjs clean",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "seams",
    "wallet",
    "server",
    "NEAR",
    "EVM",
    "blockchain",
    "passkey",
    "typescript",
    "sdk"
  ],
  "author": "web3authn.org",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seams-tech/seams-wallet.git"
  },
  "bugs": {
    "url": "https://github.com/seams-tech/seams-wallet/issues"
  },
  "homepage": "https://github.com/seams-tech/seams-wallet#readme",
  "dependencies": {
    "@simplewebauthn/server": "^13.2.2",
    "bs58": "^6.0.0",
    "express": "^4.21.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@near-js/types": "^2.4.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.9",
    "rolldown": "^1.0.0-beta.27",
    "typescript": "^5.8.3"
  }
}
