{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ml-dsa-silent-20261015-a",
  "main": "build/ml-dsa-a/index.js",
  "compatibility_date": "2026-07-02",
  "workers_dev": true,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 300000,
  },
  "build": {
    "command": "CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUSTFLAGS='-C target-feature=+simd128' worker-build --release --out-dir build/ml-dsa-a --features ml-dsa-a",
    "watch_dir": "src",
  },
  "services": [
    {
      "binding": "ML_DSA_B",
      "service": "ml-dsa-silent-20261015-b",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
