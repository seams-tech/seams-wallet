{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ml-dsa-prepared-20261014-a",
  "main": "build/ml-dsa-a/index.js",
  "compatibility_date": "2026-07-02",
  "workers_dev": true,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 300000
  },
  "build": {
    "command": "worker-build --release --out-dir build/ml-dsa-a --features ml-dsa-a",
    "watch_dir": "src"
  },
  "services": [
    {
      "binding": "ML_DSA_B",
      "service": "ml-dsa-prepared-20261014-b"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
