{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ml-dsa-probe-20261013-b",
  "main": "src/transport_probe.mjs",
  "compatibility_date": "2026-07-02",
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 10000 },
  "vars": { "PROBE_ROLE": "b", "PROBE_DO_HINT": "apac" },
  "durable_objects": { "bindings": [{ "name": "PROBE_WALLETS", "class_name": "ProbeWallet" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProbeWallet"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
