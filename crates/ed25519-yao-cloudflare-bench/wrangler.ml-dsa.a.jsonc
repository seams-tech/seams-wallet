{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ml-dsa-kernel-20261013-a",
  "main": "build/ml-dsa-a/index.js",
  "compatibility_date": "2026-07-02",
  "workers_dev": true,
  "preview_urls": false,
  "limits": { "cpu_ms": 30000 },
