# Non-secret, plan-only R120 cross-account benchmark boundary.
YAOS_AB_TOPOLOGY=two-account
YAOS_AB_A_ACCOUNT_ID=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
YAOS_AB_B_ACCOUNT_ID=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
YAOS_AB_A_PROFILE=r120-deriver-a
YAOS_AB_B_PROFILE=r120-deriver-b
YAOS_AB_A_SCRIPT_NAME=ed25519-yao-ab-benchmark-a-cross-account
YAOS_AB_B_SCRIPT_NAME=ed25519-yao-ab-benchmark-b-cross-account
YAOS_AB_A_PUBLIC_ENDPOINT=https://ed25519-yao-ab-benchmark-a-cross-account.r120-deriver-a.workers.dev/benchmark/activation
YAOS_AB_B_HOSTNAME=ed25519-yao-ab-benchmark-b-cross-account.r120-deriver-b.workers.dev
YAOS_AB_B_WEBSOCKET_ENDPOINT=wss://ed25519-yao-ab-benchmark-b-cross-account.r120-deriver-b.workers.dev/benchmark/activation
YAOS_AB_SAMPLE_COUNT=101
YAOS_AB_REGION_LABEL=tokyo-runner-1
YAOS_AB_DEPLOYMENT_RECEIPT_PATH=/absolute/path/r120-two-account-deployment.json

# Start with paired latency. Run resource-current and resource-candidate in
# separate exclusive windows by replacing this value for each campaign.
YAOS_AB_R120_CAMPAIGN=paired-latency
YAOS_AB_R120_RESOURCE_CAMPAIGN_PATH=/absolute/path/r120-cross-resource-campaign.json

# The three immutable outputs consumed by the offline selection preflight.
YAOS_AB_R120_CROSS_ACCOUNT_LATENCY_REPORT=/absolute/path/r120-cross-latency.json
YAOS_AB_R120_CROSS_ACCOUNT_CURRENT_RESOURCE_REPORT=/absolute/path/r120-cross-resource-current.json
YAOS_AB_R120_CROSS_ACCOUNT_CANDIDATE_RESOURCE_REPORT=/absolute/path/r120-cross-resource-candidate.json

# Required only with the explicit --execute switch.
YAOS_AB_CONFIRM_NON_PRODUCTION=REPLACE_WITH_YES
YAOS_AB_CONFIRM_NO_AUTH_CLAIM=REPLACE_WITH_YES
YAOS_AB_CONFIRM_DELETE_BENCHMARK=REPLACE_WITH_YES

# Read-only Account Analytics tokens stay in the invoking shell.
# export CLOUDFLARE_ANALYTICS_TOKEN_A=...
# export CLOUDFLARE_ANALYTICS_TOKEN_B=...
