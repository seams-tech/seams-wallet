# Non-secret, plan-only R120 same-account benchmark boundary.
YAOS_AB_TOPOLOGY=one-account
YAOS_AB_A_ACCOUNT_ID=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
YAOS_AB_B_ACCOUNT_ID=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
YAOS_AB_A_PROFILE=r120-same-account
YAOS_AB_B_PROFILE=r120-same-account
YAOS_AB_A_SCRIPT_NAME=ed25519-yao-ab-benchmark-a
YAOS_AB_B_SCRIPT_NAME=ed25519-yao-ab-benchmark-b
YAOS_AB_A_PUBLIC_ENDPOINT=https://ed25519-yao-ab-benchmark-a.r120-same-account.workers.dev/benchmark/activation
YAOS_AB_SAMPLE_COUNT=101
YAOS_AB_REGION_LABEL=tokyo-runner-1
YAOS_AB_DEPLOYMENT_RECEIPT_PATH=/absolute/path/r120-one-account-deployment.json

# Start with paired latency. Run resource-current and resource-candidate in
# separate exclusive windows by replacing this value for each campaign.
YAOS_AB_R120_CAMPAIGN=paired-latency
YAOS_AB_R120_RESOURCE_CAMPAIGN_PATH=/absolute/path/r120-same-resource-campaign.json

# The three immutable outputs consumed by the offline selection preflight.
YAOS_AB_R120_SAME_ACCOUNT_LATENCY_REPORT=/absolute/path/r120-same-latency.json
YAOS_AB_R120_SAME_ACCOUNT_CURRENT_RESOURCE_REPORT=/absolute/path/r120-same-resource-current.json
YAOS_AB_R120_SAME_ACCOUNT_CANDIDATE_RESOURCE_REPORT=/absolute/path/r120-same-resource-candidate.json

# Required only with the explicit --execute switch.
YAOS_AB_CONFIRM_NON_PRODUCTION=REPLACE_WITH_YES
YAOS_AB_CONFIRM_NO_AUTH_CLAIM=REPLACE_WITH_YES
YAOS_AB_CONFIRM_DELETE_BENCHMARK=REPLACE_WITH_YES

# Read-only Account Analytics tokens stay in the invoking shell.
# export CLOUDFLARE_ANALYTICS_TOKEN_A=...
# CLOUDFLARE_ANALYTICS_TOKEN_B may be omitted in one-account mode.
