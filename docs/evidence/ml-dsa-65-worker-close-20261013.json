{
  "schema": "seams.ml-dsa-worker-close-diagnosis.v1",
  "classification": "production_regression in the experimental benchmark adapter",
  "fault": "B produced the expected private kernel result, then Cloudflare marked its request as a hung-request exception.",
  "facts": [
    {
      "fact": "The first hosted campaign had 24 successful role output checks and 24 B exception buckets.",
      "instrument": "Hosted result JSON and Cloudflare workersInvocationsAdaptive analytics.",
      "version": "fda25a06-7506-46e6-a895-139ee10b503f"
    },
    {
      "fact": "A separate tailed reproduction logged completion before the hung-request exception for eight sessions.",
      "instrument": "Wrangler live tail.",
      "checked_records": 8
    },
    {
      "fact": "The explicit-close build completed all repeated kernel outputs and produced no exceptions in the 24 matching live-tail records.",
      "instrument": "Hosted result JSON, run IDs, and Wrangler live tail.",
      "checked_records": 24,
      "version": "975431e0-4843-4536-98ef-068beb96d6b8"
    }
  ],
  "cause_table": [
    {
      "cause": "Wrong cryptographic output",
      "contradicted_by": "Both roles passed every independent expected-output check.",
      "left": false
    },
    {
      "cause": "CPU limit or memory limit",
      "contradicted_by": "Tail reported a hung request after completion, rather than a resource-limit exception.",
      "left": false
    },
    {
      "cause": "Incomplete server-side WebSocket teardown",
      "supported_by": "Explicit B close after its completion message removed the exception while preserving kernel outputs.",
      "left": true
    },
    {
      "cause": "Analytics-only reporting artifact",
      "contradicted_by": "Live tail reproduced the exception and the change removed it.",
      "left": false
    }
  ],
  "change": "B explicitly closes its own socket with code 1000 after sending its completion report.",
  "limits": [
    "The record identifies the adapter teardown cause. It does not establish the runtime internal promise or close-handshake implementation.",
    "Parity with production Router A/B admission, persistence, and orchestration is not established."
  ],
  "primary_reference": "https://developers.cloudflare.com/workers/observability/errors/#cause-2-websocket-connections-that-are-never-closed",
